{
  "name": "n8n",
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "n8n",
        "POSTGRES_PASSWORD": "fixture-db-pass",
        "POSTGRES_DB": "n8n"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "db_data",
          "target": "/var/lib/postgresql/data"
        }
      ]
    },
    "redis": {
      "image": "redis:7-alpine",
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "redis_data",
          "target": "/data"
        }
      ]
    },
    "n8n": {
      "image": "docker.n8n.io/n8nio/n8n:2.4.1",
      "restart": "unless-stopped",
      "environment": {
        "DB_TYPE": "postgresdb",
        "DB_POSTGRESDB_HOST": "postgres",
        "DB_POSTGRESDB_PORT": "5432",
        "DB_POSTGRESDB_DATABASE": "n8n",
        "DB_POSTGRESDB_USER": "n8n",
        "DB_POSTGRESDB_PASSWORD": "fixture-db-pass",
        "EXECUTIONS_MODE": "queue",
        "QUEUE_BULL_REDIS_HOST": "redis",
        "QUEUE_HEALTH_CHECK_ACTIVE": "true",
        "N8N_ENCRYPTION_KEY": "aaaabbbbccccddddeeeeffff00001111",
        "WEBHOOK_URL": "https://n8n.example.com/",
        "N8N_PROXY_HOPS": "1",
        "GENERIC_TIMEZONE": "Asia/Dhaka",
        "TZ": "Asia/Dhaka",
        "EXECUTIONS_DATA_PRUNE": "true",
        "EXECUTIONS_DATA_MAX_AGE": "336",
        "N8N_DIAGNOSTICS_ENABLED": "false",
        "OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS": "true",
        "N8N_HOST": "n8n.example.com",
        "N8N_PROTOCOL": "https"
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 5678,
          "published": "5678",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "n8n_data",
          "target": "/home/node/.n8n"
        }
      ]
    },
    "n8n-worker": {
      "image": "docker.n8n.io/n8nio/n8n:2.4.1",
      "restart": "unless-stopped",
      "command": [
        "worker",
        "--concurrency=10"
      ],
      "environment": {
        "DB_TYPE": "postgresdb",
        "DB_POSTGRESDB_HOST": "postgres",
        "DB_POSTGRESDB_PORT": "5432",
        "DB_POSTGRESDB_DATABASE": "n8n",
        "DB_POSTGRESDB_USER": "n8n",
        "DB_POSTGRESDB_PASSWORD": "fixture-db-pass",
        "EXECUTIONS_MODE": "queue",
        "QUEUE_BULL_REDIS_HOST": "redis",
        "QUEUE_HEALTH_CHECK_ACTIVE": "true",
        "N8N_ENCRYPTION_KEY": "aaaabbbbccccddddeeeeffff00001111",
        "WEBHOOK_URL": "https://n8n.example.com/",
        "N8N_PROXY_HOPS": "1",
        "GENERIC_TIMEZONE": "Asia/Dhaka",
        "TZ": "Asia/Dhaka",
        "EXECUTIONS_DATA_PRUNE": "true",
        "EXECUTIONS_DATA_MAX_AGE": "336",
        "N8N_DIAGNOSTICS_ENABLED": "false",
        "OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS": "true",
        "N8N_HOST": "n8n.example.com",
        "N8N_PROTOCOL": "https"
      }
    }
  },
  "volumes": {
    "db_data": {},
    "redis_data": {},
    "n8n_data": {}
  }
}