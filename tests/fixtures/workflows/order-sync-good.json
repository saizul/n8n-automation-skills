    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "wf-get-secret",
          "mode": "list",
          "cachedResultName": "Get signing secret"
        },
        "options": {}
      },
      "id": "23753518-aaaa-4bbb-8ccc-106996033795",
      "name": "Load signing secret",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $('Load signing secret').first().json.secret;\nconst item = $input.first();\nconst raw = Buffer.from(item.binary.data.data, 'base64');\nconst header = item.json.headers['x-shopify-hmac-sha256'] || '';\nconst sentAt = Date.parse(item.json.headers['x-shopify-triggered-at'] || '');\nif (!sentAt || Math.abs(Date.now() - sentAt) > 5 * 60 * 1000) {\n  throw new Error('Stale or missing timestamp');\n}\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('base64');\nconst ok = header.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(header), Buffer.from(expected));\nif (!ok) {\n  throw new Error('Invalid webhook signature');\n}\nreturn [{ json: JSON.parse(raw.toString('utf8')) }];\n"
      },
      "id": "27481656-aaaa-4bbb-8ccc-086237391874",
      "name": "Verify HMAC signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 202
        }
      },
      "id": "09562259-aaaa-4bbb-8ccc-825697040425",
      "name": "Acknowledge receipt",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        300
      ]
    },
