# Copy to .env, fill in, chmod 600 .env. Never commit .env.
# Pin an exact n8n release (see https://docs.n8n.io/release-notes/), for example 2.4.1
N8N_VERSION=

# Generate once with: openssl rand -hex 32
# Store a copy in your password manager: without it, stored credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=

# Public URL (the reverse proxy terminates TLS)
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_PROXY_HOPS=1

# Timezone used by Schedule Triggers and $now
GENERIC_TIMEZONE=UTC
TZ=UTC

# Database (used by the postgres service and by n8n)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Keep the executions table small: hours to keep (336 = 14 days)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Run manual editor executions on workers too
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

N8N_DIAGNOSTICS_ENABLED=false

# Allow only the modules your Code nodes need (crypto for webhook signatures)
NODE_FUNCTION_ALLOW_BUILTIN=crypto
